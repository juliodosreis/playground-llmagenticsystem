# Modelo do arquivo .env. Copie para .env e preencha os valores. Este arquivo é versionado:
# nunca escreva nele uma chave real.

# Ollama Cloud: gere uma chave em https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Endpoint do Ollama. Para um Ollama local, use http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com

# Google AI Studio: gere uma chave em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# LangSmith: gere uma chave em https://smith.langchain.com/settings. Pedida pelo Studio, cuja
# interface é servida por smith.langchain.com e exige sessão autenticada.
LANGSMITH_API_KEY=

# Envio de traces ao LangSmith. Em false, as execuções não saem do servidor local.
LANGSMITH_TRACING=false

# Provedor do agente: ollama ou google
TRAVEL_PROVIDER=ollama

# Modelo do provedor. Sem esta variável, cada provedor usa o seu padrão: gpt-oss:120b no ollama e
# gemini-3.5-flash-lite no google. Definida, vale para os dois, e trocar de provedor pede trocar o
# valor.
# TRAVEL_MODEL=

# Estratégia do grafo do agente: react ou plan-execute
TRAVEL_STRATEGY=react

# Fonte das ferramentas do agente: local, chamadas no processo, ou mcp, chamadas pelo servidor MCP
TRAVEL_TOOLS=local
